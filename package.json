{
  "name": "contact-form-server",
  "version": "1.0.0",
  "description": "Express server for handling contact form submissions with file uploads to Cloudinary and webhook support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "webhook:setup": "node -e \"console.log('Visit http://localhost:3000/webhook/setup for webhook configuration instructions')\""
  },
  "keywords": [
    "express",
    "cloudinary",
    "file-upload",
    "contact-form",
    "multer",
    "nodejs",
    "webhooks",
    "real-time"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.0",
    "multer-storage-cloudinary": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/contact-form-server.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/contact-form-server/issues"
  },
  "homepage": "https://github.com/yourusername/contact-form-server#readme"
}